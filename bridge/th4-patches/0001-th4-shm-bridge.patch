@@ -0,0 +1,23 @@
+// d1export.cpp — экспорт FineMap/TileBlockWalking для D1-моста
+#include "stdafx.h"
+#include <stdio.h>
+
+// FineMap и TileBlockWalking уже объявлены в vars.h (включён через stdafx.h)
+// Дублирующие объявления не нужны — просто используем их напрямую
+
+void D1ExportMap()
+{
+    FILE* f = fopen("d1map_export.txt", "w");
+    if (!f) return;
+    
+    fprintf(f, "FineMap=0x%08X\n", (unsigned int)FineMap);
+    fprintf(f, "TileBlockWalking=0x%08X\n", (unsigned int)TileBlockWalking);
+    fprintf(f, "TileMap=0x%08X\n", (unsigned int)TileMap);
+    fprintf(f, "PlayerMap=0x%08X\n", (unsigned int)PlayerMap);
+    fprintf(f, "IsWall=0x%08X\n", (unsigned int)IsWall);
+    fprintf(f, "TransMap=0x%08X\n", (unsigned int)TransMap);
+    fprintf(f, "TileBlockSight=0x%08X\n", (unsigned int)TileBlockSight);
+    fprintf(f, "TileBlockMissle=0x%08X\n", (unsigned int)TileBlockMissle);
+    
+    fclose(f);
+}
